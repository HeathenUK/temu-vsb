@@ -271,6 +271,10 @@ if ?PMIOPL eq 0
 externdef _I2f168A_Hdpmi_InOutExcHandler_back:abs
 externdef _I2F168A_HDPMI_IOTP_BACK:abs
 endif
+if ?COVOXR0
