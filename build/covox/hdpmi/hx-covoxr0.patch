diff --git a/Src/HDPMI/HDPMI.ASM b/Src/HDPMI/HDPMI.ASM
index 4d71640..c0dd23e 100644
--- a/Src/HDPMI/HDPMI.ASM
+++ b/Src/HDPMI/HDPMI.ASM
@@ -1663,6 +1663,27 @@ setINIRQ:
 	shl esi, cl
 	pop ecx
 
+	if ?COVOXR0
+;--- a covox game tick: the ring-0 fast path (intr08) marked this
+;--- reflection for the CURRENT CLIENT's own int8 vector - the game's
+;--- timer ISR is registered in ITS client table, which the routed
+;--- handler (the audio backend, a different client) would shadow.
