+    if scenario == 'sb':
+        # testsb.com resets the SB DSP and reads 0x22A from PM; PortHandler must
+        # emulate it. 'SB'<status>'END'; status 0xAA = DSP ready.
+        lpt = out / 'lpt.bin'
